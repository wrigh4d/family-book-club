rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function clubPath() {
      return /databases/$(database)/documents/clubs/$(clubId);
    }

    function memberPath() {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    // Club already exists (reads / subcollection writes).
    function isCreator() {
      return signedIn()
        && exists(clubPath())
        && get(clubPath()).data.createdBy == request.auth.uid;
    }

    function isOwner() {
      return isCreator()
        || (
          signedIn()
          && exists(memberPath())
          && get(memberPath()).data.role == 'owner'
        );
    }

    // Club is being created in this same batch/transaction.
    function isCreatorAfter() {
      return signedIn()
        && existsAfter(clubPath())
        && getAfter(clubPath()).data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow get, write: if isSelf(userId);
      allow list: if false;
    }

    // Club code is the document ID. Anyone signed in who knows the code can
    // read that club. Listing the collection would leak every code.
    match /clubs/{clubId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == clubId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      // Do not get() this same document during an update — use resource.
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          resource.data.createdBy == request.auth.uid
          || (
            exists(memberPath())
            && get(memberPath()).data.role == 'owner'
          )
        );
      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn();
        allow create: if isSelf(userId)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && (
            request.resource.data.role == 'member'
            || (request.resource.data.role == 'owner' && isCreatorAfter())
          );
        allow update: if isSelf(userId)
          && request.resource.data.role == resource.data.role;
        allow delete: if false;
      }

      match /rules/{ruleId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.createdBy == request.auth.uid;
      }

      match /shortlist/{itemId} {
        allow read, write: if signedIn();
      }

      match /history/{itemId} {
        allow read, write: if signedIn();
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow create: if isCreatorAfter();
        allow update: if isOwner();
        allow delete: if false;

        match /genreVotes/{userId} {
          allow read: if signedIn();
          allow write: if isSelf(userId) || isOwner();
        }

        match /nominations/{itemId} {
          allow read: if signedIn();
          allow write: if isOwner();
        }
      }
    }
  }
}
