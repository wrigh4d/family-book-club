rules_version = '2';
// family-book-club rules v3
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function clubPath() {
      return /databases/$(database)/documents/clubs/$(clubId);
    }

    function memberPath() {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function clubExists() {
      return exists(clubPath());
    }

    function isCreator() {
      return signedIn() && clubExists() && get(clubPath()).data.createdBy == request.auth.uid;
    }

    function isOwner() {
      return isCreator()
        || (signedIn() && exists(memberPath()) && get(memberPath()).data.role == 'owner');
    }

    match /users/{userId} {
      allow get, write: if isSelf(userId);
      allow list: if false;
    }

    match /clubs/{clubId} {
      allow get: if signedIn();
      allow list: if false;

      // Any signed-in person can start a club they own.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn();
        allow create: if isSelf(userId)
          && (
            request.resource.data.role == 'member'
            || request.resource.data.role == 'owner'
          );
        allow update: if isSelf(userId)
          && request.resource.data.role == resource.data.role;
        allow delete: if false;
      }

      match /rules/{ruleId} {
        allow read, write: if signedIn();
      }

      match /shortlist/{itemId} {
        allow read, write: if signedIn();
      }

      match /history/{itemId} {
        allow read, write: if signedIn();
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update: if isOwner();
        allow delete: if false;

        match /genreVotes/{userId} {
          allow read: if signedIn();
          allow write: if isSelf(userId) || isOwner();
        }

        match /nominations/{itemId} {
          allow read, write: if signedIn();
        }
      }
    }
  }
}
