# Copy to android/keystore.properties (gitignored) for a local release build.
# Leave these blank until you have the real upload keystore. Do not invent values.
#
# storeFile is a path to the .jks/.keystore file. Relative paths are from the android/ directory.
# CI can set these environment variables instead of this file:
#   ANDROID_KEYSTORE_PATH
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
#
# Debug builds do not read this file. They use the Android debug keystore.

storeFile=
storePassword=
keyAlias=
keyPassword=
