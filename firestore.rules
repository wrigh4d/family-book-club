rules_version = '2';
// family-book-club rules v8
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, write: if isSelf(userId);
      allow list: if false;

      match /fcmTokens/{tokenId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['token', 'origin', 'base', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() < 4096
          && request.resource.data.origin is string
          && request.resource.data.origin.size() < 200
          && (
            request.resource.data.origin.matches('https://.+')
            || request.resource.data.origin.matches('http://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?')
          )
          && request.resource.data.base is string
          && request.resource.data.base.size() > 0
          && request.resource.data.base.size() < 200
          && request.resource.data.base.matches('/.*')
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Collection-group queries need this recursive match. Signed-in users can
    // find member rows (and therefore club codes) across clubs; the client
    // keeps only request.auth.uid. Public listing of /clubs is still forbidden.
    match /{path=**}/members/{userId} {
      allow read: if signedIn();
    }

    match /clubs/{clubId} {
      function clubDoc() {
        return /databases/$(database)/documents/clubs/$(clubId);
      }

      function memberDoc() {
        return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      }

      function isCreator() {
        return signedIn()
          && exists(clubDoc())
          && get(clubDoc()).data.createdBy == request.auth.uid;
      }

      function isOwner() {
        return isCreator()
          || (
            signedIn()
            && exists(memberDoc())
            && get(memberDoc()).data.role == 'owner'
          );
      }

      function isMember() {
        return signedIn() && exists(memberDoc());
      }

      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn();
        allow create: if isSelf(userId)
          && (
            request.resource.data.role == 'member'
            || (
              request.resource.data.role == 'owner'
              && existsAfter(clubDoc())
              && getAfter(clubDoc()).data.createdBy == request.auth.uid
            )
          );
        allow update: if isSelf(userId)
          && request.resource.data.role == resource.data.role;
        allow delete: if false;
      }

      match /rules/{ruleId} {
        allow read: if signedIn();
        allow write: if isMember();
      }

      match /shortlist/{itemId} {
        allow read: if signedIn();
        allow write: if isMember();
      }

      match /history/{itemId} {
        allow read: if signedIn();
        allow write: if isMember();
      }

      match /messages/{messageId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(memberDoc()).data.displayName
          && request.resource.data.text is string
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt >= request.time - duration.value(10, 'm')
          && request.resource.data.createdAt <= request.time + duration.value(10, 'm');
        allow update, delete: if false;
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow create: if isOwner()
          || (
            signedIn()
            && existsAfter(clubDoc())
            && getAfter(clubDoc()).data.createdBy == request.auth.uid
            && existsAfter(memberDoc())
          );
        allow update: if isOwner();
        allow delete: if false;

        match /genreVotes/{userId} {
          allow read: if signedIn();
          allow write: if isSelf(userId) || isOwner();
        }

        match /nominations/{itemId} {
          allow read: if signedIn();
          allow write: if isMember();
        }
      }
    }
  }
}
