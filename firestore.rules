rules_version = '2';
// family-book-club rules v6
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, write: if isSelf(userId);
      allow list: if false;
    }

    // Collection-group queries need this recursive match. Signed-in users can
    // find member rows (and therefore club codes) across clubs; the client
    // keeps only request.auth.uid. Public listing of /clubs is still forbidden.
    match /{path=**}/members/{userId} {
      allow read: if signedIn();
    }

    match /clubs/{clubId} {
      function clubDoc() {
        return /databases/$(database)/documents/clubs/$(clubId);
      }

      function memberDoc() {
        return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
      }

      function isCreator() {
        return signedIn()
          && exists(clubDoc())
          && get(clubDoc()).data.createdBy == request.auth.uid;
      }

      function isOwner() {
        return isCreator()
          || (
            signedIn()
            && exists(memberDoc())
            && get(memberDoc()).data.role == 'owner'
          );
      }

      function isMember() {
        return signedIn() && exists(memberDoc());
      }

      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;

      match /members/{userId} {
        allow read: if signedIn();
        allow create: if isSelf(userId)
          && (
            request.resource.data.role == 'member'
            || (
              request.resource.data.role == 'owner'
              && existsAfter(clubDoc())
              && getAfter(clubDoc()).data.createdBy == request.auth.uid
            )
          );
        allow update: if isSelf(userId)
          && request.resource.data.role == resource.data.role;
        allow delete: if false;
      }

      match /rules/{ruleId} {
        allow read: if signedIn();
        allow write: if isMember();
      }

      match /shortlist/{itemId} {
        allow read: if signedIn();
        allow write: if isMember();
      }

      match /history/{itemId} {
        allow read: if signedIn();
        allow write: if isMember();
      }

      match /rounds/{roundId} {
        allow read: if signedIn();
        allow create: if isOwner()
          || (
            signedIn()
            && existsAfter(clubDoc())
            && getAfter(clubDoc()).data.createdBy == request.auth.uid
            && existsAfter(memberDoc())
          );
        allow update: if isOwner();
        allow delete: if false;

        match /genreVotes/{userId} {
          allow read: if signedIn();
          allow write: if isSelf(userId) || isOwner();
        }

        match /nominations/{itemId} {
          allow read: if signedIn();
          allow write: if isMember();
        }
      }
    }
  }
}
