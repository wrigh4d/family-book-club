# Copy this file to .env.local and fill in the Firebase web app settings.
# .env.local stays off git. Never put a serviceAccountKey.json in this project.
# The web API key is still embedded in the built site. Firestore rules protect the data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
